source "https://rubygems.org"

# Bộ github-pages mô phỏng đúng môi trường build của GitHub Pages
gem "github-pages", group: :jekyll_plugins

# Cần cho remote_theme khi build/preview local
gem "jekyll-remote-theme"

# Xử lý múi giờ trên một số OS
gem "tzinfo-data", platforms: [:mingw, :mswin, :x64_mingw, :jruby]

# Tăng tốc preview local
gem "webrick", "~> 1.7"
